# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets: commit .env.example, never .env
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Generated by the pipeline: never commit (each person regenerates locally)
outputs/
.cache/
*.log

# Large binaries: models, indexes, embeddings
models/
*.faiss
*.index
*.pt
*.pth
*.bin
*.safetensors
*.gguf
*.pkl
*.npy

# Notebooks: never commit checkpoints; strip outputs before committing (nbstripout)
.ipynb_checkpoints/

# Personal tool settings (shared project config stays committed)
.claude/settings.local.json
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
