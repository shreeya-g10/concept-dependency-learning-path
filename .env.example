# Copy to .env (never commit .env). Everything here is free.

# Default: Ollama running locally (https://ollama.com), no key needed.
#   ollama pull qwen2.5:7b-instruct
#   ollama pull llama3.1:8b        # second model family for validation
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_VALIDATOR_MODEL=llama3.1:8b

# Alternative if your laptop can't run a 7B model: any free-tier
# OpenAI-compatible endpoint. Set the three lines below and use a free key.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://<provider>/v1
# LLM_API_KEY=<your free-tier key>

# Embeddings (local, free)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
