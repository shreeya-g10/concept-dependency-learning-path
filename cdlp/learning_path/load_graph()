
"""Knowledge graph operations for the CDLP learning path module."""

import networkx as nx


def load_graph(validated_graph: dict) -> nx.DiGraph:
    """Build a graph using only accepted prerequisite relationships."""
    graph = nx.DiGraph()

    for node in validated_graph.get("nodes", []):
        graph.add_node(node["id"], **node)

    for edge in validated_graph.get("edges", []):
        if edge.get("decision") != "ACCEPT":
            continue

        source = edge["source"]
        target = edge["target"]

        graph.add_edge(
            source,
            target,
            strength=edge.get("strength", "hard"),
            evidence=edge.get("evidence", []),
        )

    return graph


def prerequisites(G: nx.DiGraph, concept: str) -> set[str]:
    """Return all prerequisites of a concept."""
    if concept not in G:
        raise ValueError(f"Unknown concept: {concept}")

    return nx.ancestors(G, concept)


def dependents(G: nx.DiGraph, concept: str) -> set[str]:
    """Return all concepts depending on the given concept."""
    if concept not in G:
        raise ValueError(f"Unknown concept: {concept}")

    return nx.descendants(G, concept)


def generic_path(G: nx.DiGraph, target: str) -> list[str]:
    """Return all prerequisites and the target in topological order."""
    required = prerequisites(G, target) | {target}
    subgraph = G.subgraph(required)

    if not nx.is_directed_acyclic_graph(subgraph):
        raise ValueError("The prerequisite graph contains a cycle.")

    return list(nx.topological_sort(subgraph))
