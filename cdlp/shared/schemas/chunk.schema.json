{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "one line of chunks.jsonl",
  "type": "object",
  "required": [
    "chunk_id",
    "course_id",
    "doc",
    "page",
    "text"
  ],
  "properties": {
    "chunk_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "doc": {
      "type": "string"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "heading": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
