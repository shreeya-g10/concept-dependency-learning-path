{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "validated_graph.json",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "stable slug, e.g. binary_search_tree"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "type",
          "strength",
          "decision",
          "confidence",
          "checks",
          "evidence",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "stable slug, e.g. binary_search_tree"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "stable slug, e.g. binary_search_tree"
          },
          "type": {
            "enum": [
              "PREREQUISITE"
            ]
          },
          "strength": {
            "enum": [
              "hard",
              "soft"
            ]
          },
          "decision": {
            "enum": [
              "ACCEPT",
              "REJECT",
              "HUMAN_REVIEW"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "checks": {
            "type": "object",
            "required": [
              "evidence",
              "semantic",
              "necessity",
              "graph"
            ],
            "properties": {
              "evidence": {
                "enum": [
                  "strong",
                  "medium",
                  "weak",
                  "none",
                  "skipped"
                ],
                "description": "'skipped' (added in 1.5): the check was not run (an ablation, or no course text); it never blocks ACCEPT."
              },
              "semantic": {
                "enum": [
                  "strong",
                  "medium",
                  "weak",
                  "none",
                  "skipped"
                ],
                "description": "'skipped' (added in 1.5): the check was not run (an ablation, or no course text); it never blocks ACCEPT."
              },
              "necessity": {
                "enum": [
                  "strong",
                  "medium",
                  "weak",
                  "none",
                  "skipped"
                ],
                "description": "'skipped' (added in 1.5): the check was not run (an ablation, or no course text); it never blocks ACCEPT."
              },
              "graph": {
                "enum": [
                  "ok",
                  "cycle",
                  "duplicate",
                  "redundant",
                  "self_loop",
                  "contradiction",
                  "skipped"
                ],
                "description": "'skipped' (added in 1.5): the check was not run (an ablation, or no course text); it never blocks ACCEPT."
              }
            }
          },
          "necessity_gap": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "chunk_id"
              ],
              "properties": {
                "chunk_id": {
                  "type": "string"
                },
                "doc": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "reason": {
            "type": "string"
          },
          "score_control": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "added in 1.4: necessity-test score of the control learner (knows A, unrelated C banned)"
          },
          "score_without": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "added in 1.4: necessity-test score of the learner with A banned; necessity_gap = score_control - score_without"
          },
          "n_questions": {
            "type": "integer",
            "minimum": 1,
            "description": "added in 1.4: questions per necessity-test run"
          },
          "question_format": {
            "enum": [
              "open",
              "mcq"
            ],
            "description": "added in 1.4: necessity-test question format"
          },
          "review": {
            "type": "object",
            "description": "added in 1.6: a human decision on an edge the validator sent to HUMAN_REVIEW (cdlp/validation/apply_review.py). Absent = no human decision. When status is 'applied', the edge's decision is review.decision; when 'refused_cycle', accepting would have closed a cycle, so decision stays HUMAN_REVIEW. confidence, checks, evidence and reason stay the validator's.",
            "required": [
              "decided_by",
              "decision",
              "validator_decision",
              "status"
            ],
            "properties": {
              "decided_by": {
                "type": "string",
                "description": "'teacher' (page 3) or 'simulated_teacher' (experiment)"
              },
              "decision": {
                "enum": [
                  "ACCEPT",
                  "REJECT"
                ]
              },
              "validator_decision": {
                "enum": [
                  "HUMAN_REVIEW"
                ],
                "description": "the validator's decision, restored when decisions are re-applied"
              },
              "status": {
                "enum": [
                  "applied",
                  "refused_cycle"
                ]
              },
              "comment": {
                "type": "string"
              },
              "decided_at": {
                "type": "string"
              },
              "cycle": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "for refused_cycle: the cycle accepting would close, first node repeated at the end"
              }
            }
          }
        }
      }
    },
    "skipped_checks": {
      "type": "array",
      "items": {
        "enum": [
          "evidence",
          "semantic",
          "necessity",
          "graph"
        ]
      },
      "uniqueItems": true,
      "description": "added in 1.5: checks this run skipped; each is written as 'skipped' on every edge."
    },
    "subset": {
      "type": "object",
      "required": [
        "kind",
        "n",
        "of",
        "selection"
      ],
      "properties": {
        "kind": {
          "enum": [
            "demo"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "of": {
          "type": "integer",
          "minimum": 0
        },
        "selection": {
          "type": "string"
        }
      },
      "description": "added in 1.8: present only when the run validated a subset of the proposed edges (e.g. --demo-subset); such a graph is a demo, not an evaluation."
    }
  }
}
