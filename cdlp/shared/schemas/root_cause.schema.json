{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "root_cause.json",
  "description": "Since 1.1. One trace per wrong answer: which concept most likely caused the mistake.",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "traces"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "student_id",
          "item_id",
          "answer",
          "traced_concept",
          "candidates",
          "confidence",
          "explanation"
        ],
        "properties": {
          "student_id": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "traced_concept": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "stable slug, e.g. binary_search_tree"
          },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "description": "concepts considered (the item's concept and its prerequisites), highest score first",
            "items": {
              "type": "object",
              "required": [
                "concept_id",
                "score"
              ],
              "properties": {
                "concept_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$",
                  "description": "stable slug, e.g. binary_search_tree"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    }
  }
}
