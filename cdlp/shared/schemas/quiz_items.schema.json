{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quiz_items.json",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "concept_id",
          "question",
          "options",
          "answer"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "concept_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "stable slug, e.g. binary_search_tree"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "string"
          },
          "chunk_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
