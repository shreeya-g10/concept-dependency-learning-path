{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quiz_items.json",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "concept_id",
          "question",
          "options",
          "answer"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "concept_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "stable slug, e.g. binary_search_tree"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "string"
          },
          "chunk_id": {
            "type": "string"
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "description": "optional (1.6): how the items were generated: model, prompt_version, temperature, seed, skipped items per reason, concepts without chunks or items",
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "max_chunks_per_concept": {
          "type": "integer"
        },
        "concepts": {
          "type": "integer"
        },
        "concepts_without_chunks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "concepts_without_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    }
  }
}
