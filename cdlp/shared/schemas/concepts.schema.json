{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "concepts.json",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "concepts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "stable slug, e.g. binary_search_tree"
          },
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "doc",
                "page"
              ],
              "properties": {
                "doc": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "chunk_id": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "dedup_method": {
      "enum": [
        "embedding",
        "tfidf",
        "jaccard",
        "mixed"
      ],
      "description": "added in 1.7: how concept names were compared when merging duplicates. embedding = sentence embeddings (all-MiniLM-L6-v2); tfidf / jaccard = fallbacks, used only with --allow-tfidf; mixed = more than one in one run."
    },
    "dedup_comparisons": {
      "type": "object",
      "description": "added in 1.7: number of fuzzy name comparisons per method (embedding, tfidf, jaccard) and failed embedding attempts (embedding_failed). Exact and acronym matches are not counted.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
