{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "relationships.json",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "type",
          "strength",
          "confidence",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "stable slug, e.g. binary_search_tree"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "stable slug, e.g. binary_search_tree"
          },
          "type": {
            "enum": [
              "PREREQUISITE"
            ]
          },
          "strength": {
            "enum": [
              "hard",
              "soft"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "chunk_id"
              ],
              "properties": {
                "chunk_id": {
                  "type": "string"
                },
                "doc": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "method": {
            "type": "string"
          },
          "bidirectional": {
            "type": "boolean",
            "description": "added in 1.2: the LLM said DIRECT in both directions (tied course position). The validator must pick the direction or send it to HUMAN_REVIEW."
          },
          "reverse_strength": {
            "enum": [
              "hard",
              "soft"
            ],
            "description": "added in 1.2: strength the LLM gave target -> source (only with bidirectional)"
          },
          "reverse_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "added in 1.2: confidence for target -> source (only with bidirectional)"
          },
          "pair_order": {
            "type": "object",
            "description": "optional (1.10): which concept the neutral prompt called A and which B, and what it answered",
            "required": [
              "a",
              "b",
              "rule",
              "answer"
            ],
            "properties": {
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "answer": {
                "type": "string",
                "enum": [
                  "A_BEFORE_B",
                  "B_BEFORE_A",
                  "NEITHER"
                ]
              }
            }
          },
          "order_agreement": {
            "type": "string",
            "enum": [
              "stable",
              "unstable",
              "reversed"
            ],
            "description": "optional (1.11): how the link fared across both orders; rule in cdlp/discovery/configs/order_rule_v1.json"
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "description": "optional (1.10): written by neutral prompts such as discover_v3_1. Counts every answer of the run, including NEITHER, so a position bias can be measured.",
      "required": [
        "prompt_version",
        "pair_order_rule",
        "answers"
      ],
      "properties": {
        "prompt_version": {
          "type": "string"
        },
        "pair_order_rule": {
          "type": "string",
          "description": "how A and B were chosen: lower_id_first (discover_v3) or sha256_of_pair_v1 (discover_v3_1)"
        },
        "answers": {
          "type": "object",
          "description": "A_BEFORE_B, B_BEFORE_A, NEITHER, off_topic, hard and soft are counts over the run; confidence counts the proposed edges per confidence value",
          "properties": {
            "A_BEFORE_B": {
              "type": "integer",
              "minimum": 0
            },
            "B_BEFORE_A": {
              "type": "integer",
              "minimum": 0
            },
            "NEITHER": {
              "type": "integer",
              "minimum": 0
            },
            "off_topic": {
              "type": "integer",
              "minimum": 0
            },
            "hard": {
              "type": "integer",
              "minimum": 0
            },
            "soft": {
              "type": "integer",
              "minimum": 0
            },
            "confidence": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "both_orders": {
          "type": "object",
          "description": "optional (1.11): counts per pair under the order rule. answers then counts the hash-order asks only.",
          "required": [
            "rule_version",
            "pairs",
            "stable",
            "unstable",
            "reversed",
            "neither"
          ],
          "properties": {
            "rule_version": {
              "type": "string"
            },
            "pairs": {
              "type": "integer",
              "minimum": 0
            },
            "stable": {
              "type": "integer",
              "minimum": 0
            },
            "unstable": {
              "type": "integer",
              "minimum": 0
            },
            "reversed": {
              "type": "integer",
              "minimum": 0
            },
            "neither": {
              "type": "integer",
              "minimum": 0
            },
            "answers_all_asks": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "pair_answers": {
      "type": "array",
      "description": "optional (1.11): both raw answers per asked pair, including NEITHER. asks[0] is the hash-order ask, so one-order results can be computed from the same run.",
      "items": {
        "type": "object",
        "required": [
          "order_agreement",
          "asks"
        ],
        "properties": {
          "order_agreement": {
            "type": "string",
            "enum": [
              "stable",
              "unstable",
              "reversed",
              "neither"
            ]
          },
          "asks": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "pair_a",
                "pair_b",
                "answer"
              ],
              "properties": {
                "pair_a": {
                  "type": "string"
                },
                "pair_b": {
                  "type": "string"
                },
                "answer": {
                  "type": "string",
                  "enum": [
                    "A_BEFORE_B",
                    "B_BEFORE_A",
                    "NEITHER"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
