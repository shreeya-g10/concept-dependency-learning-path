{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "relationships.json",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "type",
          "strength",
          "confidence",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "stable slug, e.g. binary_search_tree"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "stable slug, e.g. binary_search_tree"
          },
          "type": {
            "enum": [
              "PREREQUISITE"
            ]
          },
          "strength": {
            "enum": [
              "hard",
              "soft"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "chunk_id"
              ],
              "properties": {
                "chunk_id": {
                  "type": "string"
                },
                "doc": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "method": {
            "type": "string"
          },
          "bidirectional": {
            "type": "boolean",
            "description": "added in 1.2: the LLM said DIRECT in both directions (tied course position). The validator must pick the direction or send it to HUMAN_REVIEW."
          },
          "reverse_strength": {
            "enum": [
              "hard",
              "soft"
            ],
            "description": "added in 1.2: strength the LLM gave target -> source (only with bidirectional)"
          },
          "reverse_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "added in 1.2: confidence for target -> source (only with bidirectional)"
          }
        }
      }
    }
  }
}
